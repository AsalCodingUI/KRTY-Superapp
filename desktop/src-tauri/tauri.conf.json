{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kretya Flow",
  "mainBinaryName": "Kretya Flow",
  "version": "0.3.1",
  "identifier": "com.kretyastudio.krty",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCOEZBNTI0NDhFRjlDNTUKUldSVm5POUlKS1dQbTUvcmtVaTJpYVFvenVWYzJsNSthM3ZzMWVoR0ZacFYwT2JUTDdZVzJiZDEK",
      "endpoints": [
        "https://app.kretyastudio.com/api/desktop/update?target={{target}}&arch={{arch}}&current={{current_version}}"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["krty"]
      }
    }
  }
}
